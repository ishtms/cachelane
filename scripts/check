#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

repository_status() {
  git status --porcelain=v1 --untracked-files=all -- . \
    ':(top,exclude).env' \
    ':(top,exclude)apps/web/.next' \
    ':(top,exclude)apps/web/node_modules' \
    ':(top,exclude)apps/web/tsconfig.tsbuildinfo' \
    ':(top,exclude)fuzz/artifacts' \
    ':(top,exclude)fuzz/target' \
    ':(top,exclude)node_modules' \
    ':(top,exclude)target'
}

baseline_status="$(repository_status)"
next_env_backup="$(mktemp -t faultlane-next-env.XXXXXX)"
cp apps/web/next-env.d.ts "$next_env_backup"

finish() {
  local status="$?"
  local final_status
  trap - EXIT INT TERM

  cp "$next_env_backup" apps/web/next-env.d.ts || status=1
  rm -f -- "$next_env_backup" || status=1

  final_status="$(repository_status)"
  if [[ "$final_status" != "$baseline_status" ]]; then
    echo "complete check changed the worktree" >&2
    repository_status >&2
    status=1
  fi

  exit "$status"
}

trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

FAULTLANE_BASE_SHA="${FAULTLANE_BASE_SHA:-HEAD}" ./scripts/check-pr
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo build --workspace --release
corepack pnpm --filter @faultlane/web build
./scripts/with-test-database bash -c '
  set -euo pipefail
  for test in \
    dashboard_and_search_stay_bounded_at_documented_scale \
    default_retention_path_is_constant_at_one_million_raw_objects \
    concurrent_schedulers_drain_more_than_two_hundred_thousand_due_objects \
    hot_issue_publication_stays_bounded_at_one_hundred_thousand_events \
    concurrent_workers_drain_a_hot_project_without_starving_another
  do
    cargo test --package faultlane-server "$test" -- --ignored --test-threads=1
  done
'
./scripts/check-fuzz
FAULTLANE_BROWSER_USE_RELEASE=true \
  FAULTLANE_BROWSER_SKIP_BUILD=true \
  ./scripts/prove-browser
