#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

for command in cargo corepack docker git node rustup; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "missing required command: $command" >&2
    exit 1
  fi
done

rustup toolchain install 1.97.1 --profile minimal --component clippy,rustfmt
rustup toolchain install nightly-2026-08-14 --profile minimal

if ! cargo fuzz --version 2>/dev/null | grep -Fq '0.13.2'; then
  cargo install cargo-fuzz --version 0.13.2 --locked
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "created .env with development-only values"
fi

corepack pnpm install --frozen-lockfile
cargo fetch --locked

if ! ./scripts/check-playwright >/dev/null 2>&1; then
  corepack pnpm --filter @faultlane/web exec playwright install chrome
fi

docker compose --env-file .env -f deploy/docker-compose/compose.yml config --quiet

echo "setup complete"
