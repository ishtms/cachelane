#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

for command in cargo corepack docker git node rustup; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "missing required command: $command" >&2
    exit 1
  fi
done

rustup toolchain install 1.97.1 --profile minimal --component clippy,rustfmt

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "created .env with development-only values"
fi

corepack pnpm install --frozen-lockfile
cargo fetch --locked
docker compose --env-file .env -f deploy/docker-compose/compose.yml config --quiet

echo "setup complete"
