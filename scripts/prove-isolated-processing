#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ ! -f .env ]]; then
  echo "missing .env; run ./scripts/setup" >&2
  exit 1
fi

set -a
source .env
set +a

proof_id="$$"
compose_project="faultlane-311-proof-$proof_id"
processor_base_image="faultlane-processor:proof-base-$proof_id"
processor_image="faultlane-processor:proof-$proof_id"
boundary_container="faultlane-311-boundary-$proof_id"
proof_directory="$(mktemp -d -t faultlane-311-proof.XXXXXX)"
proof_directory="$(cd "$proof_directory" && pwd -P)"
proof_temp_root="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
proof_name="$(basename "$proof_directory")"
export FAULTLANE_WORKER_SCRATCH_DIR="$(cygpath -w "$proof_directory/worker-scratch")"
server_executable="$(cygpath -w "$repo_root/target/debug/faultlane-server.exe")"
node_executable="$(cygpath -w "$(command -v node).exe")"
web_directory="$(cygpath -w "$repo_root/apps/web")"
next_executable="$(cygpath -w "$repo_root/apps/web/node_modules/next/dist/bin/next")"
api_pid=""
ingest_pid=""
worker_pid=""
worker_two_pid=""
web_pid=""
started_pid=""

export POSTGRES_DB="faultlane_311_proof"
export FAULTLANE_POSTGRES_PORT="${FAULTLANE_PROOF_POSTGRES_PORT:-55433}"
export FAULTLANE_MINIO_PORT="${FAULTLANE_PROOF_MINIO_PORT:-59010}"
export FAULTLANE_MINIO_CONSOLE_PORT="${FAULTLANE_PROOF_MINIO_CONSOLE_PORT:-59011}"
export OBJECT_STORE_BUCKET="faultlane-311-proof"
export OBJECT_STORE_ENDPOINT="http://127.0.0.1:$FAULTLANE_MINIO_PORT"
export DATABASE_URL="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:$FAULTLANE_POSTGRES_PORT/$POSTGRES_DB"
export FAULTLANE_API_PORT="${FAULTLANE_PROOF_API_PORT:-58090}"
export FAULTLANE_INGEST_PORT="${FAULTLANE_PROOF_INGEST_PORT:-58091}"
export FAULTLANE_API_URL="http://127.0.0.1:$FAULTLANE_API_PORT"
export INGEST_BASE_URL="http://127.0.0.1:$FAULTLANE_INGEST_PORT"
export FAULTLANE_WEB_PORT="${FAULTLANE_PROOF_WEB_PORT:-53090}"
export FAULTLANE_WEB_URL="http://127.0.0.1:$FAULTLANE_WEB_PORT"
export FAULTLANE_INGEST_SPOOL_DIR="$(cygpath -w "$proof_directory/ingest-spool")"
export FAULTLANE_BOOTSTRAP_ENABLED=true
export FAULTLANE_BOOTSTRAP_SECRET="faultlane-proof-bootstrap-secret-$proof_id"
export FAULTLANE_RATE_LIMIT_SECRET="faultlane-proof-rate-limit-secret-$proof_id"
export FAULTLANE_TRUSTED_PROXY_CIDRS=""
export FAULTLANE_SYMBOL_UPLOAD_ENABLED=true
export FAULTLANE_ISOLATED_PROCESSING_ENABLED=true
export FAULTLANE_WORKER_CONCURRENCY=2
export FAULTLANE_PROJECT_CONCURRENCY=2
export FAULTLANE_GROUPING_ENABLED=true
export FAULTLANE_REPROCESSING_ENABLED=true
export FAULTLANE_DASHBOARD_ENABLED=true
export FAULTLANE_RAW_ARTIFACT_DOWNLOAD_ENABLED=true
export FAULTLANE_PROCESSOR_IMAGE="$processor_image"

proof_phase() {
  echo "proof: $1" >&2
}

start_role() {
  local role="$1"
  local log_name="${2:-$role}"
  local executable
  local stdout_log
  local stderr_log
  local pid_file
  executable="$server_executable"
  stdout_log="$(cygpath -w "$proof_directory/$log_name.log")"
  stderr_log="$(cygpath -w "$proof_directory/$log_name-error.log")"
  pid_file="$(cygpath -w "$proof_directory/$log_name.pid")"
  powershell.exe -NoProfile -NonInteractive -Command \
    "\$process = Start-Process -FilePath '$executable' -ArgumentList '$role' -RedirectStandardOutput '$stdout_log' -RedirectStandardError '$stderr_log' -WindowStyle Hidden -PassThru; [IO.File]::WriteAllText('$pid_file', \$process.Id.ToString())" \
    >/dev/null
  started_pid="$(tr -d '\r\n' <"$proof_directory/$log_name.pid")"
  if [[ ! "$started_pid" =~ ^[0-9]+$ ]]; then
    echo "failed to start $role role" >&2
    exit 1
  fi
}

stop_role() {
  local pid="$1"
  if [[ -n "$pid" ]]; then
    powershell.exe -NoProfile -NonInteractive -Command \
      "\$process = Get-Process -Id $pid -ErrorAction SilentlyContinue; if (\$null -ne \$process -and [IO.Path]::GetFullPath(\$process.Path) -eq [IO.Path]::GetFullPath('$server_executable')) { Stop-Process -Id $pid -Force; Wait-Process -Id $pid -Timeout 10 -ErrorAction SilentlyContinue }" >/dev/null
  fi
}

start_web() {
  local stdout_log
  local stderr_log
  local pid_file
  stdout_log="$(cygpath -w "$proof_directory/web.log")"
  stderr_log="$(cygpath -w "$proof_directory/web-error.log")"
  pid_file="$(cygpath -w "$proof_directory/web.pid")"
  powershell.exe -NoProfile -NonInteractive -Command \
    "\$process = Start-Process -FilePath '$node_executable' -ArgumentList '$next_executable', 'start', '--hostname', '127.0.0.1', '--port', '$FAULTLANE_WEB_PORT' -WorkingDirectory '$web_directory' -RedirectStandardOutput '$stdout_log' -RedirectStandardError '$stderr_log' -WindowStyle Hidden -PassThru; [IO.File]::WriteAllText('$pid_file', \$process.Id.ToString())" \
    >/dev/null
  web_pid="$(tr -d '\r\n' <"$proof_directory/web.pid")"
  if [[ ! "$web_pid" =~ ^[0-9]+$ ]]; then
    echo "failed to start the production web server" >&2
    exit 1
  fi
}

stop_web() {
  if [[ -n "$web_pid" ]]; then
    powershell.exe -NoProfile -NonInteractive -Command \
      "\$process = Get-Process -Id $web_pid -ErrorAction SilentlyContinue; if (\$null -ne \$process -and [IO.Path]::GetFullPath(\$process.Path) -eq [IO.Path]::GetFullPath('$node_executable')) { Stop-Process -Id $web_pid -Force; Wait-Process -Id $web_pid -Timeout 10 -ErrorAction SilentlyContinue }" >/dev/null
    web_pid=""
  fi
}

cleanup() {
  local status="$?"
  if [[ "$status" -ne 0 ]]; then
    for log in "$proof_directory"/*.log; do
      if [[ -f "$log" ]]; then
        echo "==> $log" >&2
        cat "$log" >&2
      fi
    done
    if docker compose \
      --project-name "$compose_project" \
      --env-file .env \
      -f deploy/docker-compose/compose.yml \
      exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
      "SELECT to_regclass('public.jobs');" 2>/dev/null | grep -q jobs; then
      docker compose \
        --project-name "$compose_project" \
        --env-file .env \
        -f deploy/docker-compose/compose.yml \
        exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c \
        "SELECT job_type, state, attempt, resource_failures, failure_code FROM jobs ORDER BY created_at; SELECT artifact_type, state, failure_code FROM artifact_upload_sessions ORDER BY created_at; SELECT artifact_type, state, failure_code FROM release_manifest_artifacts ORDER BY source_path;" >&2 || true
    fi
  fi
  for pid in "$api_pid" "$ingest_pid" "$worker_pid" "$worker_two_pid"; do
    stop_role "$pid" || true
  done
  stop_web || true
  docker rm --force "$boundary_container" >/dev/null 2>&1 || true
  docker compose \
    --project-name "$compose_project" \
    --env-file .env \
    -f deploy/docker-compose/compose.yml \
    down --volumes --remove-orphans >/dev/null 2>&1 || true
  docker image rm "$processor_image" >/dev/null 2>&1 || true
  docker image rm "$processor_base_image" >/dev/null 2>&1 || true
  if [[ "$(dirname "$proof_directory")" == "$proof_temp_root" \
    && "$proof_name" =~ ^faultlane-311-proof\.[A-Za-z0-9]+$ \
    && "$proof_directory" == "$proof_temp_root/$proof_name" ]]; then
    rm -rf -- "$proof_directory"
  fi
}

trap cleanup EXIT INT TERM

proof_phase "starting PostgreSQL and object storage"
docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  up -d --wait postgres minio

docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  run --rm minio-init >/dev/null

proof_phase "building the current processor image"
docker build --quiet --tag "$processor_base_image" --file deploy/processor/Dockerfile . >/dev/null
docker build --quiet --tag "$processor_image" \
  --build-arg "PROCESSOR_IMAGE=$processor_base_image" \
  --file deploy/processor/proof.Dockerfile . >/dev/null

proof_phase "verifying the processor sandbox boundary"
mkdir "$proof_directory/boundary-input"
docker create \
  --name "$boundary_container" \
  --network none \
  --read-only \
  --mount "type=bind,src=$proof_directory/boundary-input,dst=/input,readonly" \
  --tmpfs "/scratch:rw,noexec,nosuid,nodev,size=67108864,mode=0700,uid=65532,gid=65532" \
  --user 65532:65532 \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --cpus 1 \
  --memory 2147483648 \
  --memory-swap 2147483648 \
  --pids-limit 64 \
  --ulimit nofile=256:256 \
  --ulimit cpu=120:120 \
  --entrypoint //bin/sleep \
  "$processor_image" infinity >/dev/null
docker start "$boundary_container" >/dev/null

boundary_inspect="$(docker inspect "$boundary_container")"
BOUNDARY_INSPECT="$boundary_inspect" node -e '
  const [container] = JSON.parse(process.env.BOUNDARY_INSPECT);
  const host = container.HostConfig;
  const input = container.Mounts.find(mount => mount.Destination === "/input");
  const limits = new Map(host.Ulimits.map(limit => [limit.Name, limit]));
  const valid = host.NetworkMode === "none"
    && host.ReadonlyRootfs === true
    && host.NanoCpus === 1_000_000_000
    && host.Memory === 2_147_483_648
    && host.MemorySwap === 2_147_483_648
    && host.PidsLimit === 64
    && host.CapDrop.includes("ALL")
    && host.SecurityOpt.includes("no-new-privileges")
    && host.Tmpfs["/scratch"].includes("size=67108864")
    && limits.get("nofile").Hard === 256
    && limits.get("cpu").Hard === 120
    && container.Config.User === "65532:65532"
    && container.Config.Env.every(value => value.startsWith("PATH="))
    && input && input.Type === "bind" && input.RW === false;
  if (!valid) throw new Error("processor boundary inspection failed");
'

boundary_environment="$(docker exec "$boundary_container" //usr/bin/env)"
if grep -Eiq '^(AWS_|FAULTLANE_|DATABASE_URL=|OBJECT_STORE_|[^=]*(PASSWORD|SECRET|TOKEN|KEY)=)' \
  <<<"$boundary_environment"; then
  echo "processor received a credential-like environment variable" >&2
  exit 1
fi
if timeout 5 docker exec "$boundary_container" getent ahosts example.com >/dev/null 2>&1; then
  echo "processor resolved an external host" >&2
  exit 1
fi
if docker exec "$boundary_container" touch //etc/faultlane-proof >/dev/null 2>&1; then
  echo "processor wrote to its root filesystem" >&2
  exit 1
fi
if docker exec "$boundary_container" touch //input/faultlane-proof >/dev/null 2>&1; then
  echo "processor wrote to its input mount" >&2
  exit 1
fi
docker exec "$boundary_container" touch //scratch/faultlane-proof
if docker exec "$boundary_container" dd if=/dev/zero of=//scratch/fill bs=1048576 count=65 \
  >/dev/null 2>&1; then
  echo "processor exceeded its scratch limit" >&2
  exit 1
fi
docker rm --force "$boundary_container" >/dev/null
boundary_container=""

proof_phase "building the current server and CLI"
cargo build --quiet --package faultlane-server --package faultlane-cli
./target/debug/faultlane-server migrate
if FAULTLANE_PROCESSOR_IMAGE="faultlane-processor:missing-$proof_id" \
  ./target/debug/faultlane-server worker \
  >"$proof_directory/missing-image.log" 2>&1; then
  echo "worker started without a usable processor image" >&2
  exit 1
fi

start_role api
api_pid="$started_pid"
start_role ingest
ingest_pid="$started_pid"
start_role worker
worker_pid="$started_pid"

proof_phase "waiting for API and ingest readiness"
for _ in $(seq 1 60); do
  if curl --fail --silent "$FAULTLANE_API_URL/health/ready" >/dev/null \
    && curl --fail --silent "http://127.0.0.1:$FAULTLANE_INGEST_PORT/health/ready" >/dev/null; then
    break
  fi
  sleep 1
done

curl --fail --silent "$FAULTLANE_API_URL/health/ready" >/dev/null
curl --fail --silent "http://127.0.0.1:$FAULTLANE_INGEST_PORT/health/ready" >/dev/null

json_field() {
  local path="$1"
  node -e '
    let input = "";
    process.stdin.on("data", chunk => input += chunk);
    process.stdin.on("end", () => {
      const path = process.argv[1].split(".");
      const value = path.reduce((current, field) => current[field], JSON.parse(input));
      process.stdout.write(String(value));
    });
  ' "$path"
}

wait_for_event_state() {
  local proof_event_id="$1"
  local expected_state="$2"
  local event_state=""
  local current_state=""
  for _ in $(seq 1 180); do
    event_state="$(curl --fail --silent --show-error \
      -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
      "$FAULTLANE_API_URL/api/v1/projects/$project_id/events/$proof_event_id")"
    current_state="$(json_field state <<<"$event_state")"
    if [[ "$current_state" == "$expected_state" ]]; then
      printf '%s' "$event_state"
      return 0
    fi
    if [[ "$current_state" =~ ^(failed|quarantined)$ ]]; then
      cat "$proof_directory"/worker*.log >&2
      echo "$event_state" >&2
      return 1
    fi
    sleep 1
  done
  cat "$proof_directory"/worker*.log >&2
  echo "event $proof_event_id did not reach $expected_state" >&2
  return 1
}

wait_for_reprocessing_request() {
  local request_id="$1"
  local request_state=""
  local current_state=""
  for _ in $(seq 1 240); do
    request_state="$(curl --fail --silent --show-error \
      -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
      "$FAULTLANE_API_URL/api/v1/projects/$project_id/reprocessing/$request_id")"
    current_state="$(json_field state <<<"$request_state")"
    if [[ "$current_state" =~ ^(completed|partial|failed)$ ]]; then
      printf '%s' "$request_state"
      return 0
    fi
    sleep 0.5
  done
  cat "$proof_directory"/worker*.log >&2
  echo "reprocessing request $request_id did not finish" >&2
  return 1
}

wait_for_release_ready() {
  local release_id="$1"
  local coverage=""
  for _ in $(seq 1 180); do
    coverage="$(curl --fail --silent --show-error \
      -H "Authorization: Bearer $upload_token" \
      "$FAULTLANE_API_URL/api/v1/releases/$release_id/coverage")"
    if [[ "$(json_field coverage.ready <<<"$coverage")" == "true" ]]; then
      return 0
    fi
    sleep 1
  done
  echo "release $release_id did not become ready" >&2
  return 1
}

setup_response="$(curl --fail --silent --show-error \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  -H "Content-Type: application/json" \
  --data '{"owner_email":"owner@example.com","organization_name":"FaultLane Processing Proof","organization_slug":"faultlane-processing-proof","project_name":"Windows Game","project_slug":"windows-game"}' \
  "$FAULTLANE_API_URL/api/v1/setup")"
project_id="$(json_field setup.project.id <<<"$setup_response")"
project_slug="windows-game"
ingest_key="$(json_field ingest_key.value <<<"$setup_response")"

token_response="$(curl --fail --silent --show-error \
  -X POST \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/artifact-upload-tokens")"
upload_token="$(json_field token <<<"$token_response")"

run_upload() {
  local release="$1"
  local configuration="$2"
  local build_timestamp="$3"
  FAULTLANE_TOKEN="$upload_token" ./target/debug/faultlane symbols upload \
    apps/cli/tests/fixtures/windows-symbolication \
    --project "$project_slug" \
    --release "$release" \
    --configuration "$configuration" \
    --revision fixture \
    --channel staging \
    --build-timestamp "$build_timestamp" \
    --ci-job isolated-proof \
    --api-url "$FAULTLANE_API_URL"
}

negotiate_release_without_upload() {
  local release="$1"
  local build_timestamp="$2"
  local artifact_root="${3:-apps/cli/tests/fixtures/windows-symbolication}"
  local node_artifact_root
  local scan
  local request
  node_artifact_root="$(cygpath -w "$artifact_root")"
  scan="$(./target/debug/faultlane symbols scan "$artifact_root")"
  request="$(SCAN="$scan" RELEASE="$release" BUILD_TIMESTAMP="$build_timestamp" ARTIFACT_ROOT="$node_artifact_root" node -e '
    const crypto = require("node:crypto");
    const fs = require("node:fs");
    const path = require("node:path");
    const scan = JSON.parse(process.env.SCAN);
    const root = process.env.ARTIFACT_ROOT;
    const artifacts = scan.artifacts.map(artifact => ({
      path: artifact.path,
      module: artifact.module,
      artifact_type: artifact.artifact_type,
      architecture: artifact.architecture,
      byte_size: artifact.size,
      sha256: crypto.createHash("sha256")
        .update(fs.readFileSync(path.join(root, artifact.path)))
        .digest("hex"),
      debug_id: artifact.debug_id,
      code_id: artifact.code_id,
    }));
    process.stdout.write(JSON.stringify({
      release: {
        version: process.env.RELEASE,
        platform: "windows",
        architecture: "x86_64",
        configuration: "shipping",
        revision: "fixture",
        channel: "staging",
        build_timestamp: process.env.BUILD_TIMESTAMP,
      },
      artifacts,
      cli_version: "0.1.0",
      ci_job: "isolated-proof",
    }));
  ')"
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $upload_token" \
    -H "Content-Type: application/json" \
    --data "$request" \
    "$FAULTLANE_API_URL/api/v1/projects/$project_slug/artifact-uploads"
}

first_upload="$(run_upload 1.0.0 shipping 2026-08-14T00:00:00Z)"
second_upload="$(run_upload 1.0.0 shipping 2026-08-14T00:00:00Z)"
proof_phase "processing the initial, resource, and repeat events"

stop_role "$worker_pid"
worker_pid=""

request_path="$proof_directory/crash.bundle"
resource_path="$proof_directory/resource.bundle"
repeat_path="$proof_directory/repeat.bundle"
orphan_path="$proof_directory/orphan.bundle"
storage_path="$proof_directory/storage-outage.bundle"
database_path="$proof_directory/database-outage.bundle"
distinct_path="$proof_directory/distinct.bundle"
regression_path="$proof_directory/regression.bundle"
ambiguous_path="$proof_directory/ambiguous.bundle"
reprocessing_path="$proof_directory/reprocessing.bundle"
dashboard_missing_path="$proof_directory/dashboard-missing.bundle"
node -e '
  const fs = require("node:fs");
  const zlib = require("node:zlib");
  const dump = fs.readFileSync(process.argv[1]);
  const integer = value => {
    const output = Buffer.alloc(4);
    output.writeInt32LE(value);
    return output;
  };
  const field = value => {
    const output = Buffer.alloc(264);
    output.writeInt32LE(260);
    output.write(value, 4, "ascii");
    return output;
  };
  const create = (guid, outputPath, buildVersion = "1.0.0", crashType = "Crash", errorMessage = "&lt;img src=x onerror=globalThis.pwned=true&gt;; $env:SECRET") => {
    const xml = Buffer.from(`
      <FGenericCrashContext><RuntimeProperties>
        <CrashGUID>${guid}</CrashGUID>
        <CrashType>${crashType}</CrashType>
        <ErrorMessage>${errorMessage}</ErrorMessage>
        <BuildVersion>${buildVersion}</BuildVersion>
        <EngineVersion>5.8.1</EngineVersion>
        <PlatformName>Win64</PlatformName>
        <PlatformArchitecture>x86_64</PlatformArchitecture>
        <BuildConfiguration>Shipping</BuildConfiguration>
        <UserDescription><![CDATA[</textarea><script>globalThis.pwned=true</script>]]></UserDescription>
        <Misc.OSVersionMajor>Windows 11 Pro</Misc.OSVersionMajor>
      </RuntimeProperties><PlatformProperties>
        <PlatformIsRunningWindows>1</PlatformIsRunningWindows>
      </PlatformProperties><GameData>
        <MapName>C:\\Game\\Maps\\Arena;$(calc)</MapName>
      </GameData></FGenericCrashContext>
    `);
    const log = Buffer.from("LogFaultLane: old line\nLogFaultLane: </pre><script>globalThis.pwned=true</script>\n");
    const parts = [
      Buffer.from("CR1"),
      field(guid),
      field(`${guid}.uecrash`),
      integer(0),
      integer(3),
      integer(0),
      field("CrashContext.runtime-xml"),
      integer(xml.length),
      xml,
      integer(1),
      field("UEMinidump.dmp"),
      integer(dump.length),
      dump,
      integer(2),
      field("Project.log"),
      integer(log.length),
      log,
    ];
    const expanded = Buffer.concat(parts);
    expanded.writeInt32LE(expanded.length, 531);
    fs.writeFileSync(outputPath, zlib.deflateSync(expanded));
  };
  create("UECC-Windows-Proof-311", process.argv[2]);
  create("UECC-Windows-Resource-311", process.argv[3]);
  create("UECC-Windows-Repeat-311", process.argv[4]);
  create("UECC-Windows-Orphan-311", process.argv[5]);
  create("UECC-Windows-Storage-311", process.argv[6]);
  create("UECC-Windows-Database-311", process.argv[7]);
  create("UECC-Windows-Distinct-298", process.argv[8], "1.0.0", "Assert");
  create("UECC-Windows-Regression-298", process.argv[9], "2.0.0");
  create("UECC-Windows-Ambiguous-298", process.argv[10], "3.0.0", "Assert");
  create("UECC-Windows-Reprocessing-299", process.argv[11], "5.0.0");
  create("UECC-Windows-Dashboard-Missing-300", process.argv[12], "6.0.0", "Assert", "Dashboard missing symbols 300");
 ' apps/cli/tests/fixtures/windows-symbolication/faultlane-symbolication.dmp "$request_path" "$resource_path" "$repeat_path" "$orphan_path" "$storage_path" "$database_path" "$distinct_path" "$regression_path" "$ambiguous_path" "$reprocessing_path" "$dashboard_missing_path"

resource_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$resource_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=1.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
resource_event_id="$(json_field event_id <<<"$resource_response")"

ingest_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$request_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=1.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
event_id="$(json_field event_id <<<"$ingest_response")"

start_role worker
worker_pid="$started_pid"
start_role worker worker-two
worker_two_pid="$started_pid"

proof_phase "verifying same-project processor concurrency"
concurrent_project_leases=""
for _ in $(seq 1 50); do
  concurrent_project_leases="$(docker compose \
    --project-name "$compose_project" \
    --env-file .env \
    -f deploy/docker-compose/compose.yml \
    exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
    "SELECT count(*) FROM jobs WHERE project_id::text = '$project_id' AND state = 'leased';")"
  if [[ "$concurrent_project_leases" == "2" ]]; then
    break
  fi
  sleep 0.1
done
if [[ "$concurrent_project_leases" != "2" ]]; then
  cat "$proof_directory"/worker*.log >&2
  echo "workers did not reach same-project concurrency two" >&2
  exit 1
fi

event_state=""
for _ in $(seq 1 180); do
  event_state="$(curl --fail --silent --show-error \
    -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
    "$FAULTLANE_API_URL/api/v1/projects/$project_id/events/$event_id")"
  if [[ "$(json_field state <<<"$event_state")" == "processed" ]]; then
    break
  fi
  if [[ "$(json_field state <<<"$event_state")" =~ ^(failed|quarantined)$ ]]; then
    cat "$proof_directory"/worker*.log >&2
    echo "$event_state" >&2
    exit 1
  fi
  sleep 1
done

if [[ "$(json_field state <<<"$event_state")" != "processed" ]]; then
  cat "$proof_directory"/worker*.log >&2
  echo "event did not finish processing" >&2
  exit 1
fi

resource_state=""
for _ in $(seq 1 180); do
  resource_state="$(curl --fail --silent --show-error \
    -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
    "$FAULTLANE_API_URL/api/v1/projects/$project_id/events/$resource_event_id")"
  if [[ "$(json_field state <<<"$resource_state")" == "quarantined" ]]; then
    break
  fi
  if [[ "$(json_field state <<<"$resource_state")" == "failed" ]]; then
    cat "$proof_directory"/worker*.log >&2
    echo "$resource_state" >&2
    exit 1
  fi
  sleep 1
done

if [[ "$(json_field state <<<"$resource_state")" != "quarantined" ]]; then
  cat "$proof_directory"/worker*.log >&2
  echo "resource event did not reach quarantine" >&2
  exit 1
fi

repeat_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$repeat_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=1.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
repeat_event_id="$(json_field event_id <<<"$repeat_response")"
repeat_state=""
for _ in $(seq 1 180); do
  repeat_state="$(curl --fail --silent --show-error \
    -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
    "$FAULTLANE_API_URL/api/v1/projects/$project_id/events/$repeat_event_id")"
  if [[ "$(json_field state <<<"$repeat_state")" == "processed" ]]; then
    break
  fi
  if [[ "$(json_field state <<<"$repeat_state")" =~ ^(failed|quarantined)$ ]]; then
    cat "$proof_directory"/worker*.log >&2
    echo "$repeat_state" >&2
    exit 1
  fi
  sleep 1
done

if [[ "$(json_field state <<<"$repeat_state")" != "processed" ]]; then
  cat "$proof_directory"/worker*.log >&2
  echo "repeat event did not finish processing" >&2
  exit 1
fi

proof_phase "proving issue grouping, resolution, regression, and release ambiguity"
distinct_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$distinct_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=1.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
distinct_event_id="$(json_field event_id <<<"$distinct_response")"
distinct_state="$(wait_for_event_state "$distinct_event_id" processed)"

repeated_issue_id="$(json_field issue_id <<<"$event_state")"
repeat_issue_id="$(json_field issue_id <<<"$repeat_state")"
distinct_issue_id="$(json_field issue_id <<<"$distinct_state")"
first_release_id="$(json_field release.id <<<"$first_upload")"
if [[ "$repeated_issue_id" != "$repeat_issue_id" \
  || "$repeated_issue_id" == "$distinct_issue_id" ]]; then
  echo "initial grouping did not join repeats and split the distinct crash" >&2
  exit 1
fi

resolution_response="$(curl --fail --silent --show-error \
  -X PUT \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  -H "Content-Type: application/json" \
  --data "{\"release_id\":\"$first_release_id\"}" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/issues/$repeated_issue_id/resolution")"

second_release_upload="$(run_upload 2.0.0 shipping 2026-08-15T00:00:00Z)"
second_release_id="$(json_field release.id <<<"$second_release_upload")"
wait_for_release_ready "$second_release_id"

regression_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$regression_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=2.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
regression_event_id="$(json_field event_id <<<"$regression_response")"
regression_state="$(wait_for_event_state "$regression_event_id" processed)"

ambiguous_upload_one="$(run_upload 3.0.0 shipping 2026-08-16T00:00:00Z)"
ambiguous_upload_two="$(run_upload 3.0.0 Shipping 2026-08-16T00:00:00Z)"
ambiguous_release_one="$(json_field release.id <<<"$ambiguous_upload_one")"
ambiguous_release_two="$(json_field release.id <<<"$ambiguous_upload_two")"
wait_for_release_ready "$ambiguous_release_one"
wait_for_release_ready "$ambiguous_release_two"

ambiguous_response="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$ambiguous_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=3.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
ambiguous_event_id="$(json_field event_id <<<"$ambiguous_response")"
ambiguous_state="$(wait_for_event_state "$ambiguous_event_id" awaiting_symbols)"

issue_list="$(curl --fail --silent --show-error \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/issues")"
repeated_detail="$(curl --fail --silent --show-error \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/issues/$repeated_issue_id")"
distinct_detail="$(curl --fail --silent --show-error \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/issues/$distinct_issue_id")"
ambiguous_issue_id="$(json_field issue_id <<<"$ambiguous_state")"
ambiguous_detail="$(curl --fail --silent --show-error \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_API_URL/api/v1/projects/$project_id/issues/$ambiguous_issue_id")"
grouping_database_evidence="$(docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "SELECT (SELECT count(*) FROM issues), (SELECT count(*) FROM crash_events WHERE issue_id::text = '$repeated_issue_id'), (SELECT count(*) FROM crash_event_release_candidates WHERE event_id::text = '$ambiguous_event_id'), (SELECT count(*) FROM crash_events WHERE current_result_id IS NOT NULL AND (fingerprint_algorithm IS DISTINCT FROM 'stack' OR fingerprint_version IS DISTINCT FROM 1)), (SELECT count(*) FROM crash_events WHERE current_result_id IS NOT NULL), (SELECT count(*) FROM issue_variants), (SELECT count(*) FROM issue_releases);")"

grouping_proof="$(EVENT_STATE="$event_state" REPEAT_STATE="$repeat_state" DISTINCT_STATE="$distinct_state" RESOLUTION_RESPONSE="$resolution_response" REGRESSION_STATE="$regression_state" AMBIGUOUS_STATE="$ambiguous_state" ISSUE_LIST="$issue_list" REPEATED_DETAIL="$repeated_detail" DISTINCT_DETAIL="$distinct_detail" AMBIGUOUS_DETAIL="$ambiguous_detail" GROUPING_DATABASE_EVIDENCE="$grouping_database_evidence" FIRST_RELEASE_ID="$first_release_id" SECOND_RELEASE_ID="$second_release_id" AMBIGUOUS_RELEASE_ONE="$ambiguous_release_one" AMBIGUOUS_RELEASE_TWO="$ambiguous_release_two" node -e '
  const event = JSON.parse(process.env.EVENT_STATE);
  const repeat = JSON.parse(process.env.REPEAT_STATE);
  const distinct = JSON.parse(process.env.DISTINCT_STATE);
  const resolution = JSON.parse(process.env.RESOLUTION_RESPONSE);
  const regression = JSON.parse(process.env.REGRESSION_STATE);
  const ambiguous = JSON.parse(process.env.AMBIGUOUS_STATE);
  const list = JSON.parse(process.env.ISSUE_LIST);
  const repeated = JSON.parse(process.env.REPEATED_DETAIL);
  const distinctDetail = JSON.parse(process.env.DISTINCT_DETAIL);
  const ambiguousDetail = JSON.parse(process.env.AMBIGUOUS_DETAIL);
  const firstRelease = process.env.FIRST_RELEASE_ID;
  const secondRelease = process.env.SECOND_RELEASE_ID;
  const ambiguousReleases = [
    process.env.AMBIGUOUS_RELEASE_ONE,
    process.env.AMBIGUOUS_RELEASE_TWO,
  ].sort();
  if (event.grouping_state !== "grouped"
      || event.fingerprint_algorithm !== "stack"
      || event.fingerprint_version !== 1
      || event.issue_id !== repeat.issue_id
      || event.issue_id === distinct.issue_id) {
    throw new Error("initial grouping evidence is invalid");
  }
  if (resolution.status !== "resolved" || resolution.regression_state !== "resolved") {
    throw new Error("issue resolution evidence is invalid");
  }
  if (regression.issue_id !== event.issue_id
      || regression.release_id !== secondRelease
      || regression.release_mapping_state !== "matched") {
    throw new Error("later release did not retain the stable issue");
  }
  if (ambiguous.state !== "awaiting_symbols"
      || ambiguous.grouping_state !== "grouped"
      || ambiguous.issue_id === event.issue_id
      || ambiguous.issue_id === distinct.issue_id
      || ambiguous.release_mapping_state !== "ambiguous"
      || ambiguous.release_id !== null
      || ambiguous.candidate_release_ids_truncated
      || JSON.stringify([...ambiguous.candidate_release_ids].sort()) !== JSON.stringify(ambiguousReleases)) {
    throw new Error("ambiguous release evidence is invalid");
  }
  if (list.items.length !== 3 || list.next_cursor !== null) {
    throw new Error("issue list is not stable and bounded");
  }
  if (repeated.issue_id !== event.issue_id
      || repeated.status !== "open"
      || repeated.regression_state !== "regressed"
      || repeated.event_count !== 3
      || repeated.affected_release_count !== 2
      || repeated.representative_event_id !== event.event_id
      || repeated.first_release_id !== firstRelease
      || repeated.last_release_id !== secondRelease
      || repeated.resolved_in_release_id !== firstRelease
      || repeated.release_mapping.matched !== 3
      || repeated.release_mapping.missing !== 0
      || repeated.release_mapping.ambiguous !== 0
      || repeated.variants.length !== 1
      || repeated.variants[0].event_count !== 3
      || repeated.releases.length !== 2
      || repeated.releases.reduce((count, release) => count + release.event_count, 0) !== 3
      || repeated.variants_truncated
      || repeated.releases_truncated) {
    throw new Error("repeated issue aggregation or regression evidence is invalid");
  }
  if (distinctDetail.issue_id !== distinct.issue_id
      || distinctDetail.event_count !== 1
      || distinctDetail.affected_release_count !== 1
      || distinctDetail.release_mapping.matched !== 1
      || distinctDetail.release_mapping.ambiguous !== 0) {
    throw new Error("distinct resolved issue aggregation is invalid");
  }
  if (ambiguousDetail.issue_id !== ambiguous.issue_id
      || ambiguousDetail.event_count !== 1
      || ambiguousDetail.affected_release_count !== 0
      || ambiguousDetail.release_mapping.matched !== 0
      || ambiguousDetail.release_mapping.ambiguous !== 1) {
    throw new Error("ambiguous unresolved issue aggregation is invalid");
  }
  if (process.env.GROUPING_DATABASE_EVIDENCE.trim() !== "3|3|2|0|5|3|3") {
    throw new Error(`grouping database evidence is invalid: ${process.env.GROUPING_DATABASE_EVIDENCE}`);
  }
  process.stdout.write(JSON.stringify({
    issue_count: 3,
    resolved_issue_count: 2,
    repeated_issue_id: repeated.issue_id,
    repeated_events: repeated.event_count,
    distinct_issue_id: distinctDetail.issue_id,
    affected_releases: repeated.affected_release_count,
    variants: repeated.variants.length,
    representative_event_id: repeated.representative_event_id,
    regression_state: repeated.regression_state,
    ambiguous_event_id: ambiguous.event_id,
    ambiguous_issue_id: ambiguous.issue_id,
    ambiguous_candidates: ambiguous.candidate_release_ids.length,
  }));
')"

proof_phase "proving automatic and manual crash reprocessing"
