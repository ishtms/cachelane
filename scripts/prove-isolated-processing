for sensitive in \
  "$POSTGRES_PASSWORD" \
  "$MINIO_ROOT_PASSWORD" \
  "$FAULTLANE_BOOTSTRAP_SECRET" \
  "$FAULTLANE_RATE_LIMIT_SECRET" \
  "$ingest_key" \
  "$upload_token" \
  "$reprocessing_ingest_key" \
  "$reprocessing_upload_token" \
  "UECC-Windows-" \
  "faultlane-symbolication.pdb"; do
  if [[ -n "$sensitive" ]] \
    && grep -F -- "$sensitive" "$proof_directory"/*.log >/dev/null 2>&1; then
    echo "sensitive processing content reached a service log" >&2
    exit 1
  fi
done
if ! printf 'faultlane-worker-scratch-v1\n' \
  | cmp -s - "$proof_directory/worker-scratch/.faultlane-worker-scratch"; then
  echo "worker scratch ownership marker is invalid" >&2
  exit 1
fi
if find "$proof_directory/worker-scratch" -mindepth 1 -maxdepth 1 \
  ! -name '.faultlane-worker-scratch' -print -quit \
  | grep -q .; then
  echo "worker scratch retained an attempt after processing" >&2
  exit 1
fi

proof_phase "checking final API, database, log, and scratch evidence"
database_evidence="$(docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "SELECT (SELECT count(*) FROM derived_symbol_caches WHERE project_id::text = '$project_id' AND state = 'available'), (SELECT count(*) FROM crash_processing_results WHERE event_id IN ('$event_id'::uuid, '$repeat_event_id'::uuid)), (SELECT jsonb_path_exists(result, '$.current.symbolication.threads[*].frames[*] ? (@.symbol_status == \"resolved\")') FROM crash_processing_results WHERE event_id::text = '$event_id' ORDER BY created_at DESC LIMIT 1), (SELECT state FROM jobs WHERE event_id::text = '$resource_event_id'), (SELECT attempt FROM jobs WHERE event_id::text = '$resource_event_id'), (SELECT resource_failures FROM jobs WHERE event_id::text = '$resource_event_id'), (SELECT processing_state FROM crash_events WHERE id::text = '$resource_event_id'), (SELECT count(*) FROM jobs WHERE project_id::text = '$project_id' AND job_type = 'generate_symcache'), (SELECT attempt FROM jobs WHERE event_id::text = '$storage_event_id'), (SELECT attempt FROM jobs WHERE event_id::text = '$database_event_id');")"

FIRST_UPLOAD="$first_upload" SECOND_UPLOAD="$second_upload" DATABASE_EVIDENCE="$database_evidence" EVENT_STATE="$event_state" RESOURCE_STATE="$resource_state" REPEAT_STATE="$repeat_state" ORPHAN_STATE="$orphan_state" STORAGE_STATE="$storage_state" DATABASE_STATE="$database_state" GROUPING_PROOF="$grouping_proof" REPROCESSING_PROOF="$reprocessing_proof" node -e '
  const first = JSON.parse(process.env.FIRST_UPLOAD);
  const second = JSON.parse(process.env.SECOND_UPLOAD);
  const event = JSON.parse(process.env.EVENT_STATE);
  const resource = JSON.parse(process.env.RESOURCE_STATE);
  const repeat = JSON.parse(process.env.REPEAT_STATE);
  const orphan = JSON.parse(process.env.ORPHAN_STATE);
  const storage = JSON.parse(process.env.STORAGE_STATE);
  const database = JSON.parse(process.env.DATABASE_STATE);
  const grouping = JSON.parse(process.env.GROUPING_PROOF);
  const reprocessing = JSON.parse(process.env.REPROCESSING_PROOF);
  if (first.uploaded !== 2 || first.bytes_transferred <= 0 || !first.coverage.ready) {
    throw new Error("first isolated upload failed");
  }
  if (second.uploaded !== 0 || second.already_present !== 2 || second.bytes_transferred !== 0) {
    throw new Error("second upload transferred bytes");
  }
  const evidence = process.env.DATABASE_EVIDENCE.trim().split("|");
  if (evidence.slice(0, 9).join("|") !== "1|2|t|failed|2|2|quarantined|1|2"
      || !["1", "2"].includes(evidence[9])) {
    throw new Error(`processing evidence is invalid: ${process.env.DATABASE_EVIDENCE}`);
  }
  if ([orphan, storage, database].some(event => event.grouping_state !== "disabled")) {
    throw new Error("grouping kill switch did not preserve crash processing");
  }
  process.stdout.write(JSON.stringify({
    release_id: first.release.id,
    event_id: event.event_id,
    state: event.state,
    available_artifacts: first.coverage.available,
    second_upload_bytes: second.bytes_transferred,
    symcaches: 1,
    normalized_results: 2,
    readable_frame: true,
    resource_event_id: resource.event_id,
    resource_state: resource.state,
    resource_attempts: 2,
    repeat_event_id: repeat.event_id,
    repeat_state: repeat.state,
    symcache_jobs: 1,
    concurrent_workers: 2,
    worker_concurrency: 2,
    same_project_concurrency: 2,
    processor_cpu_capacity: 4,
    processor_memory_mib_capacity: 8192,
    processor_scratch_mib_capacity: 256,
    boundary_verified: true,
    orphan_event_id: orphan.event_id,
    orphan_state: orphan.state,
    orphan_cleanup_verified: true,
    scratch_only_cleanup_verified: true,
    storage_event_id: storage.event_id,
    storage_state: storage.state,
    storage_retry_verified: true,
    database_event_id: database.event_id,
    database_state: database.state,
    database_attempts: Number(evidence[9]),
    database_retry_verified: true,
    ...grouping,
    reprocessing,
    grouping_kill_switch_verified: true,
    reprocessing_kill_switch_verified: true,
    logs_and_scratch_verified: true,
  }) + "\n");
'
