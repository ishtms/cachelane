  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "SELECT r.id::text FROM crash_reprocessing_requests r JOIN crash_reprocessing_request_events x ON x.request_id = r.id WHERE x.event_id::text = '$reprocessing_event_id' AND r.source = 'automatic' ORDER BY r.created_at LIMIT 1;")"
if [[ -z "$reprocessing_request_id" ]]; then
  echo "automatic reprocessing request was not recorded" >&2
  exit 1
fi
automatic_reprocessing_progress="$(wait_for_reprocessing_request "$reprocessing_request_id")"
reprocessing_after="$(docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "WITH current_result AS (SELECT r.result FROM crash_events e JOIN crash_processing_results r ON r.id = e.current_result_id WHERE e.id::text = '$reprocessing_event_id'), original_result AS (SELECT result FROM crash_processing_results WHERE id::text = '$reprocessing_partial_result_id') SELECT e.raw_object_id::text || '|' || e.current_result_id::text || '|' || (SELECT count(*) FROM crash_processing_results r WHERE r.event_id = e.id)::text || '|' || jsonb_array_length((SELECT result FROM current_result)->'history')::text || '|' || (SELECT count(*) FROM jsonb_array_elements((SELECT result FROM current_result)->'history') attempt WHERE attempt = (SELECT result->'current' FROM original_result))::text || '|' || jsonb_path_exists((SELECT result FROM current_result), '$.current.symbolication.threads[*].frames[*] ? (@.symbol_status == \"resolved\")')::text || '|' || (SELECT count(*) FROM crash_symbol_waiters w WHERE w.event_id = e.id)::text || '|' || e.requested_reprocessing_generation::text || '|' || e.completed_reprocessing_generation::text FROM crash_events e WHERE e.id::text = '$reprocessing_event_id';")"
IFS='|' read -r reprocessing_final_raw_id reprocessing_final_result_id reprocessing_after_results reprocessing_history_count reprocessing_original_history_count reprocessing_resolved reprocessing_after_waiters reprocessing_requested_generation reprocessing_completed_generation <<<"$reprocessing_after"
if [[ "$reprocessing_final_raw_id" != "$reprocessing_raw_id" \
  || "$reprocessing_final_result_id" == "$reprocessing_partial_result_id" \
  || "$reprocessing_after_results" -lt 2 \
  || "$reprocessing_history_count" -lt 1 \
  || "$reprocessing_history_count" -gt 16 \
  || "$reprocessing_original_history_count" != "1" \
  || "$reprocessing_resolved" != "true" \
  || "$reprocessing_after_waiters" != "0" \
  || "$reprocessing_requested_generation" -lt 1 \
  || "$reprocessing_requested_generation" != "$reprocessing_completed_generation" \
  || "$(json_field state <<<"$automatic_reprocessing_progress")" != "completed" \
  || "$(json_field selected_count <<<"$automatic_reprocessing_progress")" != "1" \
  || "$(json_field failed_count <<<"$automatic_reprocessing_progress")" != "0" ]]; then
  echo "completed reprocessing evidence is invalid: $reprocessing_after" >&2
  echo "$automatic_reprocessing_progress" >&2
  exit 1
fi

