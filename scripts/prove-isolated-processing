  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "SELECT id::text FROM project_ingest_keys WHERE project_id::text = '$project_id' AND revoked_at IS NULL LIMIT 1;")"
