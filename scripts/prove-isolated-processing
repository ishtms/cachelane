create_reprocessing_request() {
  local key="$1"
  local body="$2"
  curl --fail --silent --show-error \
    -X POST \
    -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
    -H "Idempotency-Key: $key" \
    -H "Content-Type: application/json" \
    --data "$body" \
    "$FAULTLANE_API_URL/api/v1/projects/$project_id/reprocessing"
}

reprocessing_issue_id="$(json_field issue_id <<<"$reprocessing_state")"
declare -a manual_request_ids=()
manual_event="$(create_reprocessing_request manual-event-299 "{\"scope\":{\"kind\":\"event\",\"event_id\":\"$reprocessing_event_id\"}}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_event")")
manual_issue="$(create_reprocessing_request manual-issue-299 "{\"scope\":{\"kind\":\"issue\",\"issue_id\":\"$reprocessing_issue_id\"},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_issue")")
manual_release="$(create_reprocessing_request manual-release-299 "{\"scope\":{\"kind\":\"release\",\"release_id\":\"$reprocessing_release_id\"},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_release")")
manual_project="$(create_reprocessing_request manual-project-299 "{\"scope\":{\"kind\":\"project\"},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_project")")
manual_parser="$(create_reprocessing_request manual-parser-299 "{\"scope\":{\"kind\":\"parser_version\",\"parser_version\":1},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_parser")")
manual_event_replay="$(create_reprocessing_request manual-event-299 "{\"scope\":{\"kind\":\"event\",\"event_id\":\"$reprocessing_event_id\"}}")"
if [[ "$(json_field request_id <<<"$manual_event_replay")" != "$(json_field request_id <<<"$manual_event")" ]]; then
  echo "manual request idempotency did not return the original request" >&2
  exit 1
fi
manual_conflict_status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
  -X POST \
  -H "Authorization: Bootstrap $FAULTLANE_BOOTSTRAP_SECRET" \
  -H "Idempotency-Key: manual-event-299" \
  -H "Content-Type: application/json" \
  --data '{"scope":{"kind":"project"},"limit":1}' \
  "$FAULTLANE_API_URL/api/v1/projects/$reprocessing_project_id/reprocessing")"
if [[ "$manual_conflict_status" != "409" ]]; then
  echo "manual idempotency conflict did not return 409" >&2
  exit 1
fi
for request_id in "${manual_request_ids[@]}"; do
  request_progress="$(wait_for_reprocessing_request "$request_id")"
  if [[ "$(json_field state <<<"$request_progress")" != "completed" \
    || "$(json_field selected_count <<<"$request_progress")" != "1" \
    || "$(json_field failed_count <<<"$request_progress")" != "0" ]]; then
    echo "manual reprocessing request did not complete: $request_progress" >&2
    exit 1
  fi
done

manual_symbolicator="$(create_reprocessing_request manual-symbolicator-299 "{\"scope\":{\"kind\":\"symbolicator_version\",\"symbolicator_version\":\"0.1.0\"},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_symbolicator")")
manual_fingerprint="$(create_reprocessing_request manual-fingerprint-299 "{\"scope\":{\"kind\":\"fingerprint_version\",\"fingerprint_version\":1},\"limit\":1}")"
manual_request_ids+=("$(json_field request_id <<<"$manual_fingerprint")")
