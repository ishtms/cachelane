reprocessing_upload_token="$(json_field token <<<"$reprocessing_token_response")"
project_id="$reprocessing_project_id"
project_slug="reprocessing-game"
ingest_key="$reprocessing_ingest_key"
upload_token="$reprocessing_upload_token"
missing_release="$(negotiate_release_without_upload 5.0.0 2026-08-18T00:00:00Z)"
reprocessing_release_id="$(json_field release.id <<<"$missing_release")"
reprocessing_ingest="$(curl --fail --silent --show-error \
  -H "Content-Type: application/octet-stream" \
  --data-binary "@$reprocessing_path" \
  "http://127.0.0.1:$FAULTLANE_INGEST_PORT/u/$ingest_key?AppID=WindowsGame&AppVersion=5.0.0&AppEnvironment=Shipping&UploadType=crashreports&UserID=")"
reprocessing_event_id="$(json_field event_id <<<"$reprocessing_ingest")"
start_role worker reprocessing-worker
worker_pid="$started_pid"
reprocessing_partial_state="$(wait_for_event_state "$reprocessing_event_id" awaiting_symbols)"
reprocessing_before="$(docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "SELECT e.raw_object_id::text || '|' || e.current_result_id::text || '|' || (SELECT count(*) FROM crash_processing_results r WHERE r.event_id = e.id)::text || '|' || (SELECT count(*) FROM crash_symbol_waiters w WHERE w.event_id = e.id)::text || '|' || e.requested_reprocessing_generation::text FROM crash_events e WHERE e.id::text = '$reprocessing_event_id';")"
IFS='|' read -r reprocessing_raw_id reprocessing_partial_result_id reprocessing_before_results reprocessing_before_waiters reprocessing_before_generation <<<"$reprocessing_before"
if [[ "$reprocessing_before_results" != "1" \
  || "$reprocessing_before_waiters" -lt 1 \
  || "$reprocessing_before_generation" != "0" ]]; then
  echo "partial reprocessing evidence is invalid: $reprocessing_before" >&2
  exit 1
fi

reprocessing_upload="$(run_upload 5.0.0 shipping 2026-08-18T00:00:00Z)"
