  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
  "WITH outside_organization AS (INSERT INTO organizations (name, slug) VALUES ('Outside Dashboard Proof', 'outside-dashboard-proof') RETURNING id), outside_project AS (INSERT INTO projects (organization_id, name, slug) SELECT id, 'Outside Windows Game', 'outside-windows-game' FROM outside_organization RETURNING id) SELECT id::text FROM outside_project;")"

docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" <<SQL >/dev/null
SET synchronous_commit = off;
CREATE TEMP TABLE dashboard_seed AS
SELECT
  seed_number,
  gen_random_uuid() AS issue_id,
  gen_random_uuid() AS event_id,
  gen_random_uuid() AS object_id,
  gen_random_uuid() AS result_id,
  'UECC-Windows-Dashboard-Seed-' || seed_number::text AS crash_guid,
  md5('dashboard-issue-a-' || seed_number::text)
    || md5('dashboard-issue-b-' || seed_number::text) AS fingerprint,
  now() - ((10001 - seed_number) * interval '1 second') AS observed_at
FROM generate_series(1, 10000) AS seeds(seed_number);

INSERT INTO crash_event_objects (
  id, organization_id, project_id, object_key, checksum, byte_size, media_type
)
SELECT
  object_id,
  '$primary_organization_id',
  '$project_id',
  'proof/dashboard/' || object_id::text,
  decode(
    md5('dashboard-object-a-' || seed_number::text)
      || md5('dashboard-object-b-' || seed_number::text),
    'hex'
  ),
  128,
  'application/octet-stream'
FROM dashboard_seed;

INSERT INTO crash_events (
  id, organization_id, project_id, ingest_key_id, raw_object_id, crash_guid,
  environment, processing_state, release_id, release_mapping_state,
  grouping_state, received_at, updated_at
)
SELECT
  event_id,
  '$primary_organization_id',
  '$project_id',
  '$primary_ingest_key_id',
  object_id,
  crash_guid,
  'production',
  'processed',
  '$primary_release_id',
  'matched',
  'pending',
  observed_at,
  observed_at
FROM dashboard_seed;

INSERT INTO crash_processing_results (
  id, organization_id, project_id, event_id, schema_version,
  processing_version, result, checksum, created_at
)
SELECT
  seed.result_id,
  '$primary_organization_id',
  '$project_id',
  seed.event_id,
  template.schema_version,
  template.processing_version,
  jsonb_set(
    jsonb_set(template.result, '{crash_guid}', to_jsonb(seed.crash_guid), true),
    '{crash_context,crash_guid}',
    to_jsonb(seed.crash_guid),
    true
  ),
  decode(
    md5('dashboard-result-a-' || seed.seed_number::text)
      || md5('dashboard-result-b-' || seed.seed_number::text),
    'hex'
  ),
  seed.observed_at
FROM dashboard_seed seed
CROSS JOIN LATERAL (
  SELECT schema_version, processing_version, result
  FROM crash_processing_results
  WHERE event_id::text = '$event_id'
  ORDER BY created_at DESC
  LIMIT 1
) template;

INSERT INTO crash_event_search (
  organization_id, project_id, event_id, result_id, search_text,
  crash_type, platform, architecture, engine_version, symbolication_state
)
SELECT
  '$primary_organization_id',
  '$project_id',
  seed.event_id,
  seed.result_id,
  concat_ws(
    chr(31),
    result.result #>> '{crash_context,error_message}',
    result.result #>> '{crash_context,user_comment}',
    (
      SELECT string_agg(module ->> 'module', chr(31) ORDER BY module_index)
      FROM jsonb_array_elements(result.result #> '{current,symbolication,modules}')
        WITH ORDINALITY AS modules(module, module_index)
      WHERE module ->> 'module' IS NOT NULL
    ),
    (
      SELECT string_agg(frame ->> 'function', chr(31) ORDER BY thread_index, frame_index)
      FROM jsonb_array_elements(result.result #> '{current,symbolication,threads}')
        WITH ORDINALITY AS threads(thread, thread_index)
      CROSS JOIN LATERAL jsonb_array_elements(thread -> 'frames')
        WITH ORDINALITY AS frames(frame, frame_index)
      WHERE frame ->> 'function' IS NOT NULL
    ),
    (
      SELECT string_agg(
        inline ->> 'function',
        chr(31) ORDER BY thread_index, frame_index, inline_index
      )
      FROM jsonb_array_elements(result.result #> '{current,symbolication,threads}')
        WITH ORDINALITY AS threads(thread, thread_index)
      CROSS JOIN LATERAL jsonb_array_elements(thread -> 'frames')
        WITH ORDINALITY AS frames(frame, frame_index)
      CROSS JOIN LATERAL jsonb_array_elements(frame -> 'inlines')
        WITH ORDINALITY AS inlines(inline, inline_index)
      WHERE inline ->> 'function' IS NOT NULL
    )
  ),
  result.result #>> '{crash_context,crash_type}',
  result.result #>> '{crash_context,platform,normalized}',
  result.result #>> '{crash_context,architecture}',
  result.result #>> '{crash_context,engine_version}',
  'readable'
FROM dashboard_seed seed
JOIN crash_processing_results result ON result.id = seed.result_id;

INSERT INTO issues (
  id, organization_id, project_id, fingerprint_algorithm, fingerprint_version,
  fingerprint, title, status, regression_state, first_seen_at, last_seen_at,
  event_count, representative_event_id, first_release_id, last_release_id,
  created_at, updated_at
)
SELECT
  issue_id,
  '$primary_organization_id',
  '$project_id',
  'stack',
  1,
  fingerprint,
  'Browser seed ' || seed_number::text,
  'open',
  CASE WHEN seed_number % 3 = 0 THEN 'new' ELSE 'ongoing' END,
  observed_at,
  observed_at,
  1,
  event_id,
  '$primary_release_id',
  '$primary_release_id',
  observed_at,
  observed_at
FROM dashboard_seed;

UPDATE crash_events event
SET current_result_id = seed.result_id,
    grouping_state = 'grouped',
    fingerprint_algorithm = 'stack',
    fingerprint_version = 1,
    fingerprint = seed.fingerprint,
    variant_fingerprint = seed.fingerprint,
    grouping_quality = 100,
    grouped_at = seed.observed_at,
    issue_id = seed.issue_id
FROM dashboard_seed seed
WHERE event.id = seed.event_id;

INSERT INTO issue_variants (
  organization_id, project_id, issue_id, variant_fingerprint,
  first_seen_at, last_seen_at, event_count, representative_event_id
)
SELECT
  '$primary_organization_id', '$project_id', issue_id, fingerprint,
  observed_at, observed_at, 1, event_id
FROM dashboard_seed;

INSERT INTO issue_releases (
  organization_id, project_id, issue_id, release_id,
  first_seen_at, last_seen_at, event_count, representative_event_id
)
SELECT
  '$primary_organization_id', '$project_id', issue_id, '$primary_release_id',
  observed_at, observed_at, 1, event_id
FROM dashboard_seed;

ANALYZE issues;
ANALYZE crash_events;
ANALYZE crash_processing_results;
ANALYZE crash_event_search;
SQL

docker compose \
  --project-name "$compose_project" \
  --env-file .env \
  -f deploy/docker-compose/compose.yml \
  exec -T postgres psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" <<SQL >"$proof_directory/dashboard-query-plan.log"
SET statement_timeout = '2s';
EXPLAIN (ANALYZE, BUFFERS)
SELECT i.id
FROM issues i
WHERE i.organization_id = '$primary_organization_id'::uuid
  AND i.project_id = '$project_id'::uuid
ORDER BY i.last_seen_at DESC, i.id DESC
LIMIT 101;

EXPLAIN (ANALYZE, BUFFERS)
SELECT i.id
FROM issues i
WHERE i.organization_id = '$primary_organization_id'::uuid
  AND i.project_id = '$project_id'::uuid
  AND (
    i.title ILIKE '%dashboard-worst-case-no-match%' ESCAPE chr(92)
    OR EXISTS (
      SELECT 1
      FROM crash_events e
      JOIN crash_event_search search
        ON search.organization_id = e.organization_id
       AND search.project_id = e.project_id
       AND search.event_id = e.id
       AND search.result_id = e.current_result_id
      WHERE e.organization_id = i.organization_id
        AND e.project_id = i.project_id
        AND e.issue_id = i.id
        AND search.search_text ILIKE '%dashboard-worst-case-no-match%' ESCAPE chr(92)
    )
  )
ORDER BY i.last_seen_at DESC, i.id DESC
LIMIT 101;
SQL

