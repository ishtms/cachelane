    duplicate_upload_bytes: duplicate.bytes_transferred,
    immutable_results: Number(process.env.REPROCESSING_RESULTS),
    history_count: Number(process.env.REPROCESSING_HISTORY_COUNT),
    manual_selectors: Number(process.env.MANUAL_REQUEST_COUNT),
  }));
')"
