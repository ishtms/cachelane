#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

control_file="${FAULTLANE_DEMO_CONTROL_FILE:-}"
if [[ -z "$control_file" || ! -f "$control_file" ]]; then
  echo "FAULTLANE_DEMO_CONTROL_FILE must name the protected control environment" >&2
  exit 2
fi

set -a
source "$control_file"
set +a

project="${FAULTLANE_DEMO_COMPOSE_PROJECT:-}"
if [[ ! "$project" =~ ^faultlane-demo-[a-z0-9-]+$ ]]; then
  echo "FAULTLANE_DEMO_COMPOSE_PROJECT is invalid" >&2
  exit 2
fi

compose=(docker compose --project-name "$project" -f deploy/demo/compose.yml)
if [[ "${1:-}" != "--purge-data" ]]; then
  "${compose[@]}" down --remove-orphans
  echo "demo containers and networks were removed; named data volumes were preserved"
  exit
fi

if [[ "${FAULTLANE_DEMO_CONFIRM_PURGE:-}" != "$project" ]]; then
  echo "set FAULTLANE_DEMO_CONFIRM_PURGE=$project to delete demo data" >&2
  exit 2
fi

postgres_volume="${project}_postgres-data"
minio_volume="${project}_minio-data"
for volume in "$postgres_volume" "$minio_volume"; do
  resolved="$(docker volume inspect --format '{{.Name}}' "$volume")"
  owner="$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$volume")"
  if [[ "$resolved" != "$volume" || "$owner" != "$project" ]]; then
    echo "refusing to remove unverified volume $volume" >&2
    exit 1
  fi
done

"${compose[@]}" down --volumes --remove-orphans
echo "demo containers, networks, and the two verified data volumes were deleted and cannot be recovered locally"
