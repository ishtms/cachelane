#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

api_url="${FAULTLANE_SMOKE_API_URL:-${FAULTLANE_API_URL:-http://${FAULTLANE_API_HOST:-127.0.0.1}:${FAULTLANE_API_PORT:-8080}}}"
ingest_url="${FAULTLANE_SMOKE_INGEST_URL:-${FAULTLANE_INGEST_URL:-http://${FAULTLANE_API_HOST:-127.0.0.1}:${FAULTLANE_INGEST_PORT:-8081}}}"
web_url="${FAULTLANE_SMOKE_WEB_URL:-${FAULTLANE_WEB_URL:-http://127.0.0.1:${FAULTLANE_WEB_PORT:-3000}}}"

api_response="$(curl --fail --silent --show-error "$api_url/health/ready")"
ingest_response="$(curl --fail --silent --show-error "$ingest_url/health/ready")"
web_response="$(curl --fail --silent --show-error "$web_url")"
setup_response="$(curl --fail --silent --show-error "$web_url/setup")"

if [[ "$api_response" != *'"status":"ok"'* ]]; then
  echo "API readiness response is invalid" >&2
  exit 1
fi

if [[ "$ingest_response" != *'"status":"ok"'* ]]; then
  echo "ingest readiness response is invalid" >&2
  exit 1
fi

if [[ "$web_response" != *"Crash reports"* ]]; then
  echo "web response is invalid" >&2
  exit 1
fi

if [[ "$setup_response" != *"Set up your first project"* ]]; then
  echo "setup response is invalid" >&2
  exit 1
fi

if [[ "${FAULTLANE_SMOKE_DURABLE:-false}" == "true" ]]; then
  bash scripts/prove-durable-ingest >/dev/null
elif [[ "${FAULTLANE_SMOKE_SYMBOL_UPLOAD:-false}" == "true" ]]; then
  bash scripts/prove-symbol-upload >/dev/null
fi

echo "smoke checks passed"
