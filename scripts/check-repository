#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

required_files=(
  README.md
  Cargo.toml
  package.json
  .github/scripts/start-windows-check-services.ps1
  docs/workflow/README.md
  deploy/docker-compose/compose.yml
  openapi/faultlane.yaml
  scripts/setup
  scripts/doctor
  scripts/check-playwright
  scripts/dev
  scripts/with-test-database
  scripts/check-fuzz
  scripts/prove-browser
  scripts/test-browser-proof-cleanup
  scripts/check-fast
  scripts/check-pr
  scripts/check
  scripts/smoke
)

for file in "${required_files[@]}"; do
  if [[ ! -f "$file" ]]; then
    echo "missing required repository file: $file" >&2
    exit 1
  fi
done

for script in scripts/*; do
  if [[ -f "$script" ]]; then
    bash -n "$script"
    if [[ ! -x "$script" ]]; then
      echo "repository script is not executable: $script" >&2
      exit 1
    fi
  fi
done

if grep -Eq '^corepack enable([[:space:]]|$)' scripts/setup; then
  echo "setup must not install Corepack shims globally" >&2
  exit 1
fi

if ! grep -Fxq "corepack pnpm install --frozen-lockfile" scripts/setup; then
  echo "setup must install packages through Corepack" >&2
  exit 1
fi

for package_file in package.json apps/web/package.json apps/web/tsconfig.json; do
  node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$package_file"
done

for yaml_file in \
  pnpm-workspace.yaml \
  deploy/docker-compose/compose.yml \
  openapi/faultlane.yaml \
  .github/dependabot.yml \
  .github/ISSUE_TEMPLATE/bug.yml \
  .github/ISSUE_TEMPLATE/config.yml \
  .github/ISSUE_TEMPLATE/feature.yml \
  .github/workflows/ci.yml \
  .github/workflows/security.yml; do
  node -e 'require("yaml").parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$yaml_file"
done

set +e
missing_database_command_output="$(./scripts/with-test-database 2>&1)"
missing_database_command_status="$?"
invalid_fuzz_seconds_output="$(FAULTLANE_FUZZ_SECONDS=0 ./scripts/check-fuzz 2>&1)"
invalid_fuzz_seconds_status="$?"
missing_package_output="$(
  FAULTLANE_DOCTOR_PLAYWRIGHT_PACKAGE=@faultlane/missing-playwright-package \
    ./scripts/check-playwright 2>&1
)"
missing_package_status="$?"
missing_browser_output="$(
  FAULTLANE_DOCTOR_PLAYWRIGHT_CHANNEL=faultlane-missing-browser \
    ./scripts/check-playwright 2>&1
)"
missing_browser_status="$?"
set -e

if [[ "$missing_database_command_status" -ne 2 \
  || "$missing_database_command_output" != "usage: ./scripts/with-test-database <command> [args...]" ]]; then
  echo "test database wrapper did not reject a missing command" >&2
  exit 1
fi

if [[ "$invalid_fuzz_seconds_status" -ne 2 \
  || "$invalid_fuzz_seconds_output" != "FAULTLANE_FUZZ_SECONDS must be a positive integer" ]]; then
  echo "fuzz proof did not reject an invalid duration" >&2
  exit 1
fi

if [[ "$missing_package_status" -eq 0 \
  || "$missing_package_output" != "missing: Playwright package (run corepack pnpm install --frozen-lockfile)" ]]; then
  echo "Playwright package check did not fail safely" >&2
  exit 1
fi

expected_browser_output=$'ok: Playwright package\nmissing: Chrome for Playwright (install Google Chrome or run corepack pnpm --filter @faultlane/web exec playwright install chrome)'
if [[ "$missing_browser_status" -eq 0 || "$missing_browser_output" != "$expected_browser_output" ]]; then
  echo "Playwright browser check did not fail safely" >&2
  exit 1
fi

if grep -R -Fq 'let Ok(database_url)' apps/server/src; then
  echo "database tests must not silently return when FAULTLANE_TEST_DATABASE_URL is absent" >&2
  exit 1
fi

database_test_count="$(grep -R -F 'requires FAULTLANE_TEST_DATABASE_URL' apps/server/src --include='*.rs' | wc -l | tr -d ' ')"
database_url_count="$(grep -R -F 'var("FAULTLANE_TEST_DATABASE_URL")' apps/server/src --include='*.rs' | wc -l | tr -d ' ')"
if [[ "$database_test_count" -eq 0 || "$database_test_count" -ne "$database_url_count" ]]; then
  echo "every PostgreSQL test must be explicitly ignored outside certification" >&2
  exit 1
fi

if ! grep -Fq './scripts/with-test-database cargo test --workspace --all-targets -- --ignored --test-threads=1' scripts/check-pr; then
  echo "pull request check must run the explicitly ignored PostgreSQL tests" >&2
  exit 1
fi

node <<'NODE'
const fs = require("node:fs");
const path = require("node:path");

const predicate = /\b[a-z_][a-z0-9_.]*::text\s*(?:=|<>|<=|>=|<|>|IS\s+(?:NOT\s+)?DISTINCT\s+FROM|IN\b)/i;
const forbiddenFixtures = [
  "WHERE id::text = $1",
  "WHERE event_id::text IN ($1, $2)",
  "WHERE release_id::text IS NOT DISTINCT FROM $3",
];
const allowedFixtures = [
  "SELECT id::text AS id FROM projects WHERE id = $1::uuid",
  "SELECT count(*)::text AS count FROM projects",
];

if (
  forbiddenFixtures.some((fixture) => !predicate.test(fixture)) ||
  allowedFixtures.some((fixture) => predicate.test(fixture))
) {
  throw new Error("UUID predicate guard fixtures failed");
}

const sourceDirectory = path.join("apps", "server", "src");
let found = false;
for (const name of fs.readdirSync(sourceDirectory).sort()) {
  if (!name.endsWith(".rs")) {
    continue;
  }
  const file = path.join(sourceDirectory, name);
  const source = fs.readFileSync(file, "utf8");
  const lines = source.split(/\r?\n/);
  for (let index = 0; index < lines.length; index += 1) {
    if (predicate.test(lines[index])) {
      console.error(`UUID column-side text cast found: ${file}:${index + 1}`);
      found = true;
    }
  }
}

if (found) {
  process.exit(1);
}
NODE

forbidden_dash=$'\xE2\x80\x94'
found_dash=0

while IFS= read -r -d '' file; do
  if grep -Iq . "$file" && grep -nF "$forbidden_dash" "$file"; then
    found_dash=1
  fi
done < <(git ls-files -z)

if ((found_dash > 0)); then
  echo "em dash found in repository content" >&2
  exit 1
fi

node <<'NODE'
const { execFileSync } = require("node:child_process");
const fs = require("node:fs");

const token = "cache" + "lane";
const ascii = Buffer.from(token);
const utf16le = Buffer.from(token, "utf16le");
const utf16be = Buffer.from(utf16le).swap16();
const files = execFileSync("git", ["ls-files", "-z"])
  .toString()
  .split("\0")
  .filter(Boolean);
let found = false;

for (const file of files) {
  const bytes = fs.readFileSync(file);
  for (let index = 0; index < bytes.length; index += 1) {
    if (bytes[index] >= 65 && bytes[index] <= 90) {
      bytes[index] += 32;
    }
  }

  if (
    file.toLowerCase().includes(token) ||
    bytes.includes(ascii) ||
    bytes.includes(utf16le) ||
    bytes.includes(utf16be)
  ) {
    console.error(`former product name found in tracked file: ${file}`);
    found = true;
  }
}

if (found) {
  process.exit(1);
}
NODE

echo "repository checks passed"
