#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

cargo test -p faultlane-server alerts::tests --no-fail-fast

bash ./scripts/with-test-database \
  cargo test -p faultlane-server \
  alerts::tests \
  -- --ignored --nocapture --test-threads=1

echo "alert proof: conditions, rule and issue pages, final leases, retries, and tenant scope passed"
