#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace
cargo check --locked --manifest-path fuzz/Cargo.toml --bins
corepack pnpm --filter @faultlane/web format:check
corepack pnpm --filter @faultlane/web lint
corepack pnpm --filter @faultlane/web typecheck
