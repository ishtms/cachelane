FAULTLANE_DEMO_COMPOSE_PROJECT=faultlane-demo-megagrant
FAULTLANE_DEMO_ENV_FILE=/etc/faultlane-demo/demo.env
FAULTLANE_DEMO_SERVER_IMAGE=ghcr.io/ishtms/faultlane-server@sha256:
FAULTLANE_DEMO_WEB_IMAGE=ghcr.io/ishtms/faultlane-web@sha256:
FAULTLANE_DEMO_POSTGRES_IMAGE=postgres@sha256:
FAULTLANE_DEMO_MINIO_IMAGE=minio/minio@sha256:
FAULTLANE_DEMO_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:
FAULTLANE_DEMO_PROCESSOR_SCRATCH=/var/lib/faultlane-demo/processor
FAULTLANE_DEMO_DOCKER_GID=999
FAULTLANE_DEMO_OPERATOR_API_PORT=8080
FAULTLANE_DEMO_OPERATOR_INGEST_PORT=8081
TUNNEL_TOKEN=
